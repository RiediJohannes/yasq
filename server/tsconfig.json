{
  "compilerOptions": {
    /* File Layout */
    "outDir": "./dist",
    "noEmit": true,

    /* Environment Settings */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],

    "paths": {
      "@components/*": ["../client/src/frontend/components/*"],
      "react": ["../node_modules/preact/compat"],
      "react/jsx-runtime": ["../node_modules/preact/jsx-runtime"],
      "react-dom": ["../node_modules/preact/compat"]
    },

    /* Other Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Stricter Typechecking Options */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Recommended Options */
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true, // Speeds up build by skipping type checks of node_modules
    "esModuleInterop": true // Helps with importing older JS packages
  }
}
