{
  "name": "yasq",
  "version": "1.3.0-dev",
  "private": true,
  "description": "A Multiplayer Soundtrack Quiz built as a Discord Activity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yadler97/yasq.git"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev": "concurrently \"npm run dev:server\" \"wait-on http://localhost:3001/health && npm run dev:client\"",
    "dev:mock": "cross-env VITE_MOCK_MODE=true npm run dev",
    "dev:mock:track_selection": "cross-env MOCK_STATE=../mock_data/fixtures/track_selection.json npm run dev:mock",
    "dev:mock:playing": "cross-env MOCK_STATE=../mock_data/fixtures/playing.json npm run dev:mock",
    "dev:mock:host_review": "cross-env MOCK_STATE=../mock_data/fixtures/host_review.json npm run dev:mock",
    "dev:mock:round_results": "cross-env MOCK_STATE=../mock_data/fixtures/round_results.json npm run dev:mock",
    "dev:mock:final_results": "cross-env MOCK_STATE=../mock_data/fixtures/final_results.json npm run dev:mock",
    "build": "npm run build -w client",
    "prod:server": "npm run prod -w server",
    "prod:client": "npm run preview -w client",
    "prod": "npm run build && concurrently \"npm run prod:server\" \"wait-on http://localhost:3001/health && npm run prod:client\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:unit": "concurrently \"npm run test:unit:server\" \"npm run test:unit:client\" \"npm run test:unit:shared\"",
    "test:unit:server": "npm run test -w server",
    "test:unit:client": "npm run test -w client",
    "test:unit:shared": "npm run test -w shared",
    "test:unit:coverage": "concurrently \"npm run test:unit:coverage:server\" \"npm run test:unit:coverage:client\" \"npm run test:unit:coverage:shared\"",
    "test:unit:coverage:server": "npm run test -w server -- --coverage",
    "test:unit:coverage:client": "npm run test -w client -- --coverage",
    "test:unit:coverage:shared": "npm run test -w shared -- --coverage",
    "test:integration": "cross-env VITE_MOCK_MODE=true vitest run tests/integration",
    "test:e2e": "playwright test --config=tests/playwright.config.ts --project=e2e",
    "test:e2e:ui": "playwright test --config=tests/playwright.config.ts --project=e2e --ui",
    "test:components": "playwright test --config=tests/playwright.config.ts --project=components",
    "test:components:ui": "playwright test --config=tests/playwright.config.ts --project=components --ui",
    "test:gui": "playwright test --config=tests/playwright.config.ts",
    "test:gui:ui": "playwright test --config=tests/playwright.config.ts --ui"
  },
  "dependencies": {
    "discord-api-types": "^0.38.49"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint:fix --",
      "npm run format --"
    ]
  }
}
