{
  "name": "yasq",
  "version": "1.3.0-dev",
  "private": true,
  "description": "A Multiplayer Soundtrack Quiz built as a Discord Activity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yadler97/yasq.git"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev": "concurrently \"npm run dev:server\" \"wait-on http://localhost:3001/health && npm run dev:client\"",
    "dev:mock": "cross-env VITE_MOCK_MODE=true npm run dev",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "concurrently \"npm run test:unit:server\" \"npm run test:unit:client\"",
    "test:unit:server": "npm run test -w server",
    "test:unit:client": "npm run test -w client",
    "test:unit:coverage": "concurrently \"npm run test:unit:coverage:server\" \"npm run test:unit:coverage:client\"",
    "test:unit:coverage:server": "npm run test -w server -- --coverage",
    "test:unit:coverage:client": "npm run test -w client -- --coverage",
    "test:integration": "cross-env VITE_MOCK_MODE=true vitest run tests/integration",
    "test:e2e": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts --project=e2e",
    "test:e2e:ui": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts --project=e2e --ui",
    "test:components": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts --project=components",
    "test:components:ui": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts --project=components --ui",
    "test:gui": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts",
    "test:gui:ui": "cross-env VITE_MOCK_MODE=true UI_TEST_MODE=true playwright test --config=tests/playwright.config.ts --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "discord-api-types": "^0.38.49"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint:fix --",
      "npm run format --"
    ]
  }
}
